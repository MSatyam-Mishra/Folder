<?xml version="1.0" encoding="utf-8"?>
<!-- The RAM cleaner's Extreme mode: presses Force stop on an app's info page,
     during a run the user started. It looks at the pages when it needs to, so
     it asks for no events beyond Settings' own. Its progress screen lies above
     them: flagRetrieveInteractiveWindows lets it reach the window below. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/app_closer_description"
    android:notificationTimeout="100"
    android:packageNames="com.android.settings" />
