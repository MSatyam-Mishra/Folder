<?xml version="1.0" encoding="utf-8"?>
<!-- A progress notification: see ProgressNotification.kt. Android 12 and newer
     give a collapsed one 48 dp, which this fits. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/notification_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ProgressBar
        android:id="@+id/notification_waiting"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="true"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notification_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
