<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- HeifWriter needs Android 9; it is only used there (ImageConvertNative). -->
    <uses-sdk tools:overrideLibrary="androidx.heifwriter" />
<uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- LocalSend nearby sharing: multicast discovery on the local network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Video downloader: downloads keep running in a foreground service
         with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The RAM cleaner closes background apps, where Android allows it (before 14). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Handing APKs to Android's installer (ApkInstallNative). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.usb.host" />

    <application
        android:label="Folders"
        android:usesCleartextTraffic="true"
         android:enableOnBackInvokedCallback="true"  
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
    android:networkSecurityConfig="@xml/network_security_config"
    android:exported="true"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
        >

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku hands the app its binder through this (Android/data and obb). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
             <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <meta-data
              android:name="io.flutter.embedded_views_preview"
              android:value="true" />
            <!-- Files, shared links, shortcuts and notifications reach the app through
                 its own channels (IncomingFiles). Flutter's deep linking would also take
                 an intent's address, like file:///sdcard/a.zip, as a page name, find no
                 such page and log an error each time a file arrives while the app runs. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Open with" from other apps: every type an in-app viewer handles.
                 Explicit types (not */*) keep Folders out of choosers for files it
                 would only hand to another app, e.g. APKs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <action android:name="android.intent.action.EDIT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="text/*"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="font/*"/>
                <data android:mimeType="model/*"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/epub+zip"/>
                <data android:mimeType="application/x-fictionbook+xml"/>
                <data android:mimeType="application/x-fictionbook"/>
                <data android:mimeType="application/x-mobipocket-ebook"/>
                <data android:mimeType="application/vnd.amazon.ebook"/>
                <data android:mimeType="application/vnd.amazon.mobi8-ebook"/>
                <data android:mimeType="application/vnd.comicbook+zip"/>
                <data android:mimeType="application/x-cbz"/>
                <data android:mimeType="application/msword"/>
                <data android:mimeType="application/rtf"/>
                <data android:mimeType="application/vnd.ms-works"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.template"/>
                <data android:mimeType="application/vnd.ms-word.document.macroEnabled.12"/>
                <data android:mimeType="application/vnd.ms-word.template.macroEnabled.12"/>
                <data android:mimeType="application/vnd.oasis.opendocument.text"/>
                <data android:mimeType="application/vnd.oasis.opendocument.text-template"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.template"/>
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12"/>
                <data android:mimeType="application/vnd.ms-excel.template.macroEnabled.12"/>
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet"/>
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet-template"/>
                <data android:mimeType="application/vnd.ms-powerpoint"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template"/>
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroEnabled.12"/>
                <data android:mimeType="application/vnd.ms-powerpoint.slideshow.macroEnabled.12"/>
                <data android:mimeType="application/vnd.oasis.opendocument.presentation"/>
                <data android:mimeType="application/vnd.oasis.opendocument.presentation-template"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/x-zip-compressed"/>
                <data android:mimeType="application/java-archive"/>
                <data android:mimeType="application/x-tar"/>
                <data android:mimeType="application/gzip"/>
                <data android:mimeType="application/x-gzip"/>
                <data android:mimeType="application/x-bzip2"/>
                <data android:mimeType="application/x-xz"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="application/ld+json"/>
                <data android:mimeType="application/geo+json"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="application/xhtml+xml"/>
                <data android:mimeType="application/javascript"/>
                <data android:mimeType="application/x-javascript"/>
                <data android:mimeType="application/x-sh"/>
                <data android:mimeType="application/x-yaml"/>
                <data android:mimeType="application/yaml"/>
                <data android:mimeType="application/toml"/>
                <data android:mimeType="application/sql"/>
                <data android:mimeType="application/x-sql"/>
                <data android:mimeType="application/x-subrip"/>
                <data android:mimeType="application/x-httpd-php"/>
                <data android:mimeType="application/x-font-ttf"/>
                <data android:mimeType="application/x-font-otf"/>
                <data android:mimeType="application/font-sfnt"/>
                <data android:mimeType="application/vnd.ms-opentype"/>
                <data android:mimeType="application/sla"/>
                <data android:mimeType="application/vnd.ms-pki.stl"/>
                <data android:mimeType="application/x-blender"/>
                <data android:mimeType="application/x-tgif"/>
                <data android:mimeType="application/vnd.rar"/>
                <data android:mimeType="application/x-rar-compressed"/>
                <data android:mimeType="application/x-rar"/>
                <data android:mimeType="application/x-7z-compressed"/>
                <data android:mimeType="application/x-iso9660-image"/>
                <data android:mimeType="application/vnd.comicbook-rar"/>
                <data android:mimeType="application/x-cbr"/>
                <data android:mimeType="application/x-cb7"/>
                <data android:mimeType="application/postscript"/>
                <data android:mimeType="application/illustrator"/>
                <data android:mimeType="application/x-indesign"/>
                <data android:mimeType="application/acad"/>
                <data android:mimeType="application/x-krita"/>
                <data android:mimeType="application/vnd.apple.pages"/>
                <data android:mimeType="application/vnd.apple.numbers"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>

        <!-- Each tool's own entry in the launcher's list of apps, off until the
             user asks for it from the Toolbox (DeviceNative's setInAppDrawer). -->
        <activity-alias
            android:name=".tool_ram_cleaner"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_ram_cleaner"
            android:label="RAM cleaner"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/ram_cleaner"/>
        </activity-alias>

        <!-- The Junk cleaner keeps the name it had as the Memory cleaner, so
             entries already in the app drawer stay. -->
        <activity-alias
            android:name=".tool_memory_cleaner"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_memory_cleaner"
            android:label="Junk cleaner"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/memory_cleaner"/>
        </activity-alias>

        <activity-alias
            android:name=".tool_duplicate_finder"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_duplicate_finder"
            android:label="Duplicate finder"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/duplicate_finder"/>
        </activity-alias>

        <activity-alias
            android:name=".tool_document_scanner"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_document_scanner"
            android:label="Document scanner"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/document_scanner"/>
        </activity-alias>

        <activity-alias
            android:name=".tool_video_player"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_video_player"
            android:label="Video player"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/video_player"/>
        </activity-alias>

        <activity-alias
            android:name=".tool_music_player"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_music_player"
            android:label="Music player"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/music_player"/>
        </activity-alias>

        <!-- A build without the video downloader keeps this entry off: its
             Toolbox doesn't offer the tool, so nothing turns it on, and if an
             earlier build did, the app ignores the route and just opens. -->
        <activity-alias
            android:name=".tool_video_downloader"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_video_downloader"
            android:label="Video downloader"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/video_downloader"/>
        </activity-alias>

        <activity-alias
            android:name=".tool_wifi_sharing"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_wifi_sharing"
            android:label="Wi-Fi sharing"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/wifi_sharing"/>
        </activity-alias>

        <activity-alias
            android:name=".tool_nearby_share"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tool_nearby_share"
            android:label="Nearby share"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="explorer.route" android:value="tool/nearby_share"/>
        </activity-alias>

        <!-- "Share → Download video": links shared from browsers and video apps.
             Disabled in builds without the video downloader (build.gradle.kts). -->
        <activity-alias
            android:name=".DownloadVideoShareTarget"
            android:targetActivity=".MainActivity"
            android:label="Download video"
            android:enabled="${videoDownloaderEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity-alias>

        <!-- The video player's controls outside the app, and its sound in the background. -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps copies, conversions and Wi-Fi sharing going with the app in the background. -->
        <service
            android:name=".BackgroundWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Video downloader: runs yt-dlp jobs while the app is in the background. -->
        <service
            android:name=".VideoDownloadService"
            android:enabled="${videoDownloaderEnabled}"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The RAM cleaner's Extreme mode: presses Force stop during a run the user started. -->
        <service
            android:name=".AppCloserService"
            android:exported="false"
            android:label="@string/app_closer_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_closer_service"/>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Play services fetches the text recognition model with the app. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>

    <queries>
        <!-- Who shows an app's info page, and its Force stop button's words, in the phone's language. -->
        <package android:name="com.android.settings"/>
        <!-- Whether Shizuku is installed, and opening it. -->
        <package android:name="moe.shizuku.privileged.api"/>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS"/>
            <data android:scheme="package"/>
        </intent>
        <!-- The apps the RAM cleaner can close. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Links opened from PDFs, e-books and web pages. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>