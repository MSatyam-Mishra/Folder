<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Windows app. The release workflow replaces @VERSION@
  (four numbers, e.g. 1.0.6.0) and fills in the file types for Open with
  from file-types.txt. Publisher must match the subject of the signing
  certificate (packaging/windows/explorer-msix.cer).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 rescap">

  <Identity
    Name="MSatyamMishra.Explorer"
    Publisher="CN=MSatyam-Mishra"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Explorer</DisplayName>
    <PublisherDisplayName>MSatyam-Mishra</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>The universal file manager: open, edit and share almost any file.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Explorer" Executable="explory.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Explorer"
        Description="The universal file manager: open, edit and share almost any file."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Open with: the file comes as the first argument. -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="files" Parameters="&quot;%1&quot;">
            <uap:SupportedFileTypes>
@FILE_TYPES@
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
        <!-- Shortcuts start the app through this, with their arguments: its
             own folder can't be started from outside. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="explory.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="explory.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
